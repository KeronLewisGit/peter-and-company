# Catalogue photos uploaded in the back office only. Never run scripts from this folder.
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
Options -ExecCGI -Indexes
